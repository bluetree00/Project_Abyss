  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 049f7609e16ea7f4e9b352e7d2a2c568, type: 3}
  m_Name: Dialogue_StartRoom
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequenceSO
  _lines:
  - speaker: 1
    text: "\uC7A0\uC5D0\uC11C \uAE68\uC5B4\uB098\uB77C, \uC601\uD63C\uC774\uC5EC."
  - speaker: 1
    text: "\uB108\uB97C \uC774 \uC138\uACC4\uB85C \uBD88\uB800\uB2E4. \uC2EC\uC5F0
      \uB108\uBA38 \uC7A0\uB4E4\uC5B4 \uC788\uB294 \uC601\uC6C5\uC774 \uC788\uC5B4.
      \uADF8\uAC00 \uB108\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4."
  - speaker: 2
    text: "...\uB610 \uC2DC\uC791\uC774\uAD70. \uC2E0\uC774\uC5EC, \uC774\uBC88\uC5D4
      \uBA87 \uBC88\uC9F8 \uC21C\uD658\uC778\uAC00."
  - speaker: 1
    text: "\uADF8\uAC83\uC740 \uC911\uC694\uD558\uC9C0 \uC54A\uC544. \uC911\uC694\uD55C
      \uAC74 \uC601\uD63C\uC774 \uB2E4\uC2DC \uAE68\uC5B4\uB0AC\uB2E4\uB294 \uAC83."
  - speaker: 2
    text: "\uAE30\uC5B5\uD558\uC9C0 \uBABB\uD558\uB294 \uAC83\uC774 \uC624\uD788\uB824
      \uC790\uBE44\uC77C \uC218\uB3C4 \uC788\uC9C0."
  - speaker: 1
    text: "\uC790, \uC774\uC81C \uAC00\uB77C. \uC800 \uBAB8 \uC18D\uC73C\uB85C."
