  displayName: "\uAC00\uC6E8\uC778"
  loreDesc: "\uD574\uAC00 \uC911\uCC9C\uC5D0 \uC124 \uB54C \uAC00\uC7A5 \uAC15\uD574\uC9C0\uB294
    \uAE30\uC0AC\uC758 \uC794\uC0C1. \uADF8\uC758 \uAC80\uC740 \uBCA0\uB294 \uAC83\uC774
    \uC544\uB2C8\uB77C \uD0DC\uC6B0\uB294 \uAC83\uC774\uB2E4."
  tagline: "\uD0DC\uC591\uC758 \uB9F9\uC138\uB97C \uC9CA\uC5B4\uC9C4 \uAC80"
  tags:
  - "\uC2DC\uAC04 \uC21C\uD658"
  - "\uBC84\uC2A4\uD2B8 \uAD6C\uAC04"
  - "\uD654\uC0C1"
  abilities:
  - name: "\uD558\uB8E8\uC758 \uC21C\uD658"
    kind: 0
    badge: "\uD328\uC2DC\uBE0C \xB7 \uC790\uB3D9 \uC21C\uD658"
    summary: "\uC5EC\uBA85 \u2192 \uC815\uC624 \u2192 \uD669\uD63C\uC774 \uC2A4\uC2A4\uB85C
      \uC21C\uD658\uD55C\uB2E4.\n\uC815\uC624\uAC00 \uC544\uB2D0 \uB54C \uCC98\uCE58\uB9C8\uB2E4
      \uCDA9\uC804 \uC18D\uB3C4 +20%(\uCD5C\uB300 3\uBC30)."
    stats:
    - "\uC5EC\uBA85 (20\uCD08)|\uCE5C \uC801\uC5D0\uAC8C \uD0DC\uC591\uD754 1(\uCD5C\uB300 3) \xB7 80% \uC774\uC0C1 \uACF5\uACA9\uB825 +10%"
    - "\uD669\uD63C (15\uCD08)|\uC794\uC5F4 \u2014 \uD654\uC0C1(\uCD08\uB2F9 \uACF5\uACA9\uB825
      10%)\uC774 8\uCD08\uAC04 \uD0C4\uB2E4"
    glance: "\uC5EC\uBA85\uC5D4 \uCCD0\uC11C \uD0DC\uC591\uD754 \uC313\uAE30 \xB7 \uD669\uD63C\uC5D4 Q\uAC00 \uC7A0\uAE34\uB2E4"
    glanceStats:
    - "\uD0DC\uC591\uD754|\uCD5C\uB300 3"
    - "\uCC98\uCE58 \uCDA9\uC804|+20%"
  - name: "\uC815\uC624"
    kind: 1
    badge: "\uAC8C\uC774\uC9C0 \uAC00\uB4DD \xB7 10\uCD08"
    summary: "\uC21C\uD658\uC758 \uC808\uC815. \uC9C4\uC785 \uC21C\uAC04 \uC313\uC544 \uB454 \uD0DC\uC591\uD754\uC774 \uC804\uBD80 \uD130\uC9C4\uB2E4(1\uAC1C\uB2F9 \uACF5\uACA9\uB825 100% \xB7 2m)."
    stats:
    - "\uACF5\uACA9 \uC18D\uB3C4|+30%"
    - "\uBAA8\uB4E0 \uD53C\uD574|+20%  (\uC815\uC624 \uCCAB \uD0C0\uACA9\uC740 +50%
      \uCD94\uAC00)"
    - "\uCE58\uBA85\uD0C0|\uD655\uB960 +10%p \xB7 \uD53C\uD574 +20%"
    glance: "\uC313\uC544 \uB454 \uD0DC\uC591\uD754\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uD130\uC9C4\uB2E4"
    glanceStats:
