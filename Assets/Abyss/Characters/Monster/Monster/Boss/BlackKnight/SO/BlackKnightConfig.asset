  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92fad7c4a24a8a14ebc172f2aaa6a914, type: 3}
  m_Name: BlackKnightConfig
  m_EditorClassIdentifier: Abyss.Monster::BossConfigSO
  monsterName: BlackKnight
  grade: 2
  playerLayer:
    serializedVersion: 2
    m_Bits: 0
  stat: {fileID: 11400000, guid: 73592fd233e0a3b49950dcc756a89ac5, type: 2}
  detection: {fileID: 11400000, guid: 207cf9c44feea8d47b4dea77efa55eb4, type: 2}
  patrol: {fileID: 11400000, guid: c3803eb8d90171d4396cd4cea2e5afe9, type: 2}
  combat: {fileID: 11400000, guid: e7407e8914bfaa04ca28c9c27f3b2947, type: 2}
  animation: {fileID: 11400000, guid: a9c4071f2b01ad940b09d76de2803ca3, type: 2}
  specialState0: {fileID: 0}
  specialState1: {fileID: 0}
  specialState2: {fileID: 0}
  specialState3: {fileID: 0}
  patternBreakDurationMin: 1.5
  patternBreakDurationMax: 3.5
  patternRepeatPenaltyDuration: 15
  patternRepeatPenaltyMult: 0.15
  patternEntries:
  # ── 0. [강제] 스핀 슬래시 인터럽트 ──────────────────────────────────
  # HP 임계값 도달 시 현재 패턴 끊고 즉시 발동
  - conditions:
    - {fileID: 11400000, guid: ccc5fd88bc3965045a30601a3af3e980, type: 2}
    patterns:
    - {fileID: 11400000, guid: 4f2cdf14106a4fc46b1eebd3e973a565, type: 2}
    selectionMode: 0
    forceExecute: 1
  # ── 1. [일반] Phase 2 각성 (HP<40%, 최초 1회) ───────────────────────
  # 1회 발동 후 CanExecute=false → 다음 엔트리로 자동 통과
  - conditions:
    - {fileID: 11400000, guid: 68de4da35bf1b6447b143e7fc0cd9c22, type: 2}
    patterns:
    - {fileID: 11400000, guid: 86bf28e0e7f308542aa4984ccebc9a42, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 2. [일반] Backstep 후 + 원거리 연계 ─────────────────────────────
  # 후퇴로 거리 벌린 뒤 플레이어가 멀면 → 고속 돌진 or 도약 급습
  - conditions:
    - {fileID: 11400000, guid: a08b58ac9a2220e4a98d182901ff2916, type: 2}
    - {fileID: 11400000, guid: 09824b7eea56b474ca9240b3517c5220, type: 2}
    patterns:
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: eacf3a756e644d042b0d59b223e88bf0, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 3. [일반] Backstep 후 근거리 연계 ───────────────────────────────
  # 후퇴했는데 플레이어가 바로 붙어있으면 → 돌진/강타/압박 콤보
  - conditions:
    - {fileID: 11400000, guid: a08b58ac9a2220e4a98d182901ff2916, type: 2}
    patterns:
    - {fileID: 11400000, guid: df25bca1c05b4764aaab072f23bbafee, type: 2}
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: b332dde7e9d7ed54db41749140c248ef, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 4. [일반] Sidestep 후 플랭크 공격 ───────────────────────────────
  # 측면 이동 직후 → 측면에서 강타 or 압박 콤보 (breakOverride=0.2 로 즉시 연계)
  - conditions:
    - {fileID: 11400000, guid: 64a04da47457a6d4ebc1dab8c1a04d4c, type: 2}
    patterns:
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: b332dde7e9d7ed54db41749140c248ef, type: 2}
    - {fileID: 11400000, guid: 5c07d64adc7b2ea43b5ba469477b17a9, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 5. [일반] 장기 대치 압박 (NormalModeTimer > 8초) ────────────────
  # 플레이어가 너무 오래 도망/대기하면 → 급습으로 압박
  - conditions:
    - {fileID: 11400000, guid: 6ebb8eb1dc45b8b41a2834513d444b33, type: 2}
    patterns:
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: eacf3a756e644d042b0d59b223e88bf0, type: 2}
    - {fileID: 11400000, guid: b332dde7e9d7ed54db41749140c248ef, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 6. [일반] Phase 2 + 원거리 ──────────────────────────────────────
  # 각성 후 플레이어가 멀면 → 빠른 급습 위주
  - conditions:
    - {fileID: 11400000, guid: 68de4da35bf1b6447b143e7fc0cd9c22, type: 2}
    - {fileID: 11400000, guid: 09824b7eea56b474ca9240b3517c5220, type: 2}
    patterns:
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: eacf3a756e644d042b0d59b223e88bf0, type: 2}
    - {fileID: 11400000, guid: e4a2611462b849c47b1f61f59018e3a6, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 7. [일반] Phase 2 + 근거리 ──────────────────────────────────────
  # 각성 후 플레이어가 가까우면 → 압박 콤보/강타/후퇴 혼합
  - conditions:
    - {fileID: 11400000, guid: 68de4da35bf1b6447b143e7fc0cd9c22, type: 2}
    - {fileID: 11400000, guid: d0e14223a4ef0fa4697685109d680cb5, type: 2}
    patterns:
    - {fileID: 11400000, guid: b332dde7e9d7ed54db41749140c248ef, type: 2}
    - {fileID: 11400000, guid: df25bca1c05b4764aaab072f23bbafee, type: 2}
    - {fileID: 11400000, guid: 5c07d64adc7b2ea43b5ba469477b17a9, type: 2}
    - {fileID: 11400000, guid: 06b92f43aeb188947bd8a51146be182e, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 8. [일반] Phase 2 기본 ───────────────────────────────────────────
  # 각성 후 거리 무관 → 속도/기동 위주 (느린 운석 제외), 측면 기동 추가
  - conditions:
    - {fileID: 11400000, guid: 68de4da35bf1b6447b143e7fc0cd9c22, type: 2}
    patterns:
    - {fileID: 11400000, guid: df25bca1c05b4764aaab072f23bbafee, type: 2}
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: b332dde7e9d7ed54db41749140c248ef, type: 2}
    - {fileID: 11400000, guid: e4a2611462b849c47b1f61f59018e3a6, type: 2}
    - {fileID: 11400000, guid: bf4742eabba1519448952fa48046d23f, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 9. [일반] 원거리 (거리 > 5m) ────────────────────────────────────
  # 플레이어가 멀면 → 거리 좁히는 패턴 + 원거리 공격
  - conditions:
    - {fileID: 11400000, guid: 09824b7eea56b474ca9240b3517c5220, type: 2}
    patterns:
    - {fileID: 11400000, guid: eacf3a756e644d042b0d59b223e88bf0, type: 2}
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: e4a2611462b849c47b1f61f59018e3a6, type: 2}
    - {fileID: 11400000, guid: e6ed030c75f9d0a4bb0458dcac39130c, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 10. [일반] 근거리 (거리 < 3.5m) ────────────────────────────────
  # 너무 가까우면 → 후퇴 or 측면 이동으로 공간 확보, 강타
  - conditions:
    - {fileID: 11400000, guid: d0e14223a4ef0fa4697685109d680cb5, type: 2}
    patterns:
    - {fileID: 11400000, guid: 06b92f43aeb188947bd8a51146be182e, type: 2}
    - {fileID: 11400000, guid: bf4742eabba1519448952fa48046d23f, type: 2}
    - {fileID: 11400000, guid: 5c07d64adc7b2ea43b5ba469477b17a9, type: 2}
    selectionMode: 0
    forceExecute: 0
  # ── 11. [일반] 기본 (조건 없음) ─────────────────────────────────────
  # 중거리 ~ 모든 상황 커버. 균형 잡힌 전체 패턴 풀.
  - conditions: []
    patterns:
    - {fileID: 11400000, guid: df25bca1c05b4764aaab072f23bbafee, type: 2}
    - {fileID: 11400000, guid: 5c07d64adc7b2ea43b5ba469477b17a9, type: 2}
    - {fileID: 11400000, guid: e4a2611462b849c47b1f61f59018e3a6, type: 2}
    - {fileID: 11400000, guid: e6ed030c75f9d0a4bb0458dcac39130c, type: 2}
    - {fileID: 11400000, guid: 95f8d89b198d41a43ae6233b59fe87a4, type: 2}
    - {fileID: 11400000, guid: b332dde7e9d7ed54db41749140c248ef, type: 2}
    selectionMode: 0
    forceExecute: 0
