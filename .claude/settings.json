{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.thebackend.io)",
      "WebFetch(domain:docs.backnd.com)",
      "WebFetch(domain:community.thebackend.io)",
      "WebFetch(domain:partner.steamgames.com)",
      "WebFetch(domain:blog.thebackend.io)",
      "WebFetch(domain:developer.thebackend.io)",
      "WebFetch(domain:steamcommunity.com)",
      "WebFetch(domain:backnd.com)",
      "WebFetch(domain:namu.wiki)",
      "WebFetch(domain:docs.unity3d.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:unity.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:forum.unity.com)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git pull:*)",
      "Bash(gh api:*)",
      "mcp__mcp-for-unity__create_script",
      "mcp__mcp-for-unity__delete_script",
      "mcp__mcp-for-unity__find_in_file",
      "mcp__mcp-for-unity__manage_animation",
      "mcp__mcp-for-unity__manage_texture"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$TOOL_INPUT_FILE_PATH$TOOL_INPUT_file_path\"; case \"$FILE\" in *.cs) echo '[RULE-CHECK] .cs 파일 수정 — .claude/rules/unity-csharp.md 규칙 준수 확인 필수' ;; esac"
          }
        ]
      }
    ]
  }
}