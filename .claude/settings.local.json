    ],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "mcp-for-unity"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /c/Users/User/Project_Abyss/Project_Abyss && git fetch origin -q 2>/dev/null; REMOTE=$(git rev-parse @{u} 2>/dev/null); LOCAL=$(git rev-parse HEAD 2>/dev/null); [ -n \"$REMOTE\" ] && [ \"$LOCAL\" != \"$REMOTE\" ] && echo '[Auto-Pull] 새 업데이트 발견! git pull 실행 중...' && git pull --ff-only || true"
          }
        ]
      }
    ]
  }
}
