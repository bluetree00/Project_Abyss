# ============================================================
# Unity .gitignore (Improved / Team Project Ready)
# ============================================================
# Based on:
# https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================

# ----------------------------
# Unity generated folders
# ----------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures (can be huge / sensitive)
/[Mm]emoryCaptures/

# Recordings (Timeline / Recorder)
/[Rr]ecordings/

# ----------------------------
# Asset Store / Plugins
# ----------------------------
# Uncomment if you want to ignore Asset Store Tools
# /[Aa]ssets/AssetStoreTools*

# ----------------------------
# Screenshots (dev captures — not tracked)
# ----------------------------
/[Aa]ssets/Screenshots/

# ----------------------------
# Third-party asset packages (Asset Store — reinstallable)
# ----------------------------
# (tracked — push after LFS recharge)

# JetBrains Rider autogenerated plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ----------------------------
# IDE / Editor files
# ----------------------------
.vs/
.vscode/
.idea/
.consulo/
.gradle/

# VS / Rider / Mono autogenerated files
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ----------------------------
# Unity generated meta files
# ----------------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ----------------------------
# OS generated files
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# Logs / temp
# ----------------------------
*.log
*.bak
*.orig

# 본체가 무시되는 파일의 .meta 는 함께 무시한다.
# .meta 만 올라가면 다른 작업자 Unity 에서 대상 없는 고아 meta 경고가 뜬다.
*.bak.meta
*.orig.meta
*.unitypackage.meta

# 에디터 작업 중 남기는 스크린샷/캡처 산출물
/Captures/

# ----------------------------
# Crash reports
# ----------------------------
sysinfo.txt
crashlytics-build.properties

# ----------------------------
# Build outputs
# ----------------------------
*.apk
*.aab
*.exe
*.app
*.unitypackage

# ----------------------------
# Addressables (build outputs only)
# ----------------------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.json
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.hash

# StreamingAssets Addressables build output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ----------------------------
# Android / Gradle
# ----------------------------
*.keystore

# ----------------------------
# Claude Code (개인 설정)
# ----------------------------
.claude/settings.local.json

# ----------------------------
# 룸 CSV 린터 생성 리포트 (빌드 산출물)
# ----------------------------
/ROOM_CSV_LINT_REPORT.md

# ----------------------------
# IMPORTANT (DO NOT IGNORE)
# ----------------------------
# Assets/
# ProjectSettings/
# Packages/
.vsconfig

# 외부 에셋 원본 보관소 (로컬 유지, git 추적 제외) — 사용분은 RelicFairy/_Imported로 이동됨
Assets/_ThirdParty/

# UI 프리팹 베이크 백업 (로컬 유지, git 추적 제외)
# UIPrefabBaker가 덮어쓰기 전 타임스탬프 사본을 쌓는 생성물이라 베이크할 때마다 늘어난다.
# 소스가 아니므로 공유 브랜치에 올리지 않는다 — 되돌리기는 git 히스토리로 한다.
Assets/RelicFairy/UI/_PrefabBackup/
Assets/RelicFairy/UI/_PrefabBackup.meta

# 셸 리다이렉트 사고물 — Windows엔 /dev/null이 없어 `> dev/null`이 실제 폴더를 만든다
/dev/
# 파이썬 캐시
__pycache__/
