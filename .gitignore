# ============================================================
# Unity .gitignore (Improved / Team Project Ready)
# ============================================================
# Based on:
# https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================

# ----------------------------
# Unity generated folders
# ----------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures (can be huge / sensitive)
/[Mm]emoryCaptures/

# Recordings (Timeline / Recorder)
/[Rr]ecordings/

# ----------------------------
# Asset Store / Plugins
# ----------------------------
# Uncomment if you want to ignore Asset Store Tools
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider autogenerated plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ----------------------------
# IDE / Editor files
# ----------------------------
.vs/
.vscode/
.idea/
.consulo/
.gradle/

# VS / Rider / Mono autogenerated files
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ----------------------------
# Unity generated meta files
# ----------------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ----------------------------
# OS generated files
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# Logs / temp
# ----------------------------
*.log
*.bak
*.orig

# ----------------------------
# Crash reports
# ----------------------------
sysinfo.txt
crashlytics-build.properties

# ----------------------------
# Build outputs
# ----------------------------
*.apk
*.aab
*.exe
*.app
*.unitypackage

# ----------------------------
# Addressables (build outputs only)
# ----------------------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.json
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.hash

# StreamingAssets Addressables build output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ----------------------------
# Android / Gradle
# ----------------------------
*.keystore

# ----------------------------
# Claude Code (개인 설정)
# ----------------------------
.claude/settings.local.json

# ----------------------------
# IMPORTANT (DO NOT IGNORE)
# ----------------------------
# Assets/
# ProjectSettings/
# Packages/
.vsconfig
